{
  "name": "${localWorkspaceFolderBasename}",
  "initializeCommand": [
    // "/bin/sh",
    // "${localWorkspaceFolder}/.devcontainer/prepare-build.sh"
  ],
  "build": {
    "dockerfile": "Containerfile",
    "context": ".",
    "args": {
      "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
      "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
      "http_proxy": "${localEnv:http_proxy}",
      "https_proxy": "${localEnv:https_proxy}",
      "NO_PROXY": "${localEnv:NO_PROXY}",
      "no_proxy": "${localEnv:no_proxy}"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${devcontainerId}-aws-login,target=/home/vscode/.aws,type=volume"
  ],
  "containerEnv": {
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "http_proxy": "${localEnv:http_proxy}",
    "https_proxy": "${localEnv:https_proxy}",
    "NO_PROXY": "${localEnv:NO_PROXY}",
    "no_proxy": "${localEnv:no_proxy}"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.aws && chmod 700 /home/vscode/.aws",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false
      }
    }
  }
}
