{
  "name": "claude-code-<your-name>",  //名前の変更
  "build": {
    "dockerfile": "Dockerfile"
  },    
  "runArgs": [
        "--name", "claude-code-<your-name>"  //名前の変更
    ],
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false
      }
    }
  }
}
