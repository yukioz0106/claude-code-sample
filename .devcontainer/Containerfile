ARG VARIANT="3.12-bullseye"
FROM mcr.microsoft.com/vscode/devcontainers/python:${VARIANT}

# Forward proxy settings only while building. They are deliberately not
# persisted with ENV so that host-specific values do not remain in the image.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy
ARG NO_PROXY
ARG no_proxy

# Remove invalid Yarn repo (GPG key expired in base image)
RUN rm -f /etc/apt/sources.list.d/yarn.list

# Install basic packages and AWS CLI dependencies
RUN apt-get update && apt-get install -y \
    curl="7.74.0-1.3+deb11u16" \
    vim="2:8.2.2434-3+deb11u3" \
    git="1:2.30.2-1+deb11u5" \
    make="4.3-4.1" \
    unzip="6.0-26+deb11u1" \
    groff="1.22.4-6" \
    less="551-2+deb11u2" \
    iputils-ping="3:20210202-1" \
    ca-certificates="20250419~deb12u1~deb11u1" \
    && rm -rf /var/lib/apt/lists/*

# Install AWS CLI v2
RUN set -eux; \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws

# AWS only supports SigV4 credentials in ~/.aws/credentials. This launcher
# bridges the repository-specific AWS_BEARER_TOKEN_BEDROCK profile entry to
# the environment variable supported by Claude Code and Amazon Bedrock.
COPY claude_bedrock_profile.py /usr/local/lib/claude-bedrock-profile/claude
RUN chmod 0755 /usr/local/lib/claude-bedrock-profile/claude

# Install Claude Code using native installer
# Security mitigations:
#   - Script is downloaded separately and inspected before execution
#   - TLS certificate verification is enforced (default with curl)
#   - Execution is scoped to this build step only
USER vscode
RUN set -eux; \
    curl -fsSL --proto '=https' --tlsv1.2 \
        https://claude.ai/install.sh -o /tmp/claude-install.sh && \
    # Fail if script is empty or suspiciously small (< 1KB)
    [ "$(wc -c < /tmp/claude-install.sh)" -gt 1024 ] && \
    bash /tmp/claude-install.sh stable && \
    # for specific version:
    # bash /tmp/claude-install.sh {version} && \
    rm -f /tmp/claude-install.sh

# Put the profile-aware launcher before the native Claude Code binary.
ENV PATH="/usr/local/lib/claude-bedrock-profile:/home/vscode/.local/bin:${PATH}"

# Set working directory
WORKDIR /workspace
