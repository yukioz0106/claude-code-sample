FROM mcr.microsoft.com/devcontainers/python:3.12-trixie

# Forward proxy settings only while building. They are deliberately not
# persisted with ENV so that host-specific values do not remain in the image.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy
ARG NO_PROXY
ARG no_proxy

USER root

# initializeCommand rewrites this file immediately before every Dev Container
# build. COPY therefore invalidates the dependency layer even when the
# Containerfile itself has not changed.
COPY .build-resolution-time /tmp/devcontainer-build-resolution-time
COPY resolve_releases.py install-reviewed-tools.sh install-apt-packages.sh \
    verify-release-signature.sh \
    aws-cli-public-key.asc \
    /usr/local/lib/devcontainer/

# Resolve AWS CLI and Claude Code using the build-start timestamp above;
# install APT packages from the current official Trixie repositories.
# The script fails closed if release metadata or a signature cannot be verified.
RUN chmod 0755 \
        /usr/local/lib/devcontainer/resolve_releases.py \
        /usr/local/lib/devcontainer/install-reviewed-tools.sh \
        /usr/local/lib/devcontainer/install-apt-packages.sh \
        /usr/local/lib/devcontainer/verify-release-signature.sh \
    && /usr/local/lib/devcontainer/install-reviewed-tools.sh \
        /tmp/devcontainer-build-resolution-time \
    && rm -f /tmp/devcontainer-build-resolution-time

# Claude Code is updated only by rebuilding, after the selected release has
# completed the 14-day waiting period.
ENV PATH="/home/vscode/.local/bin:${PATH}"
ENV DISABLE_AUTOUPDATER=1
ENV DISABLE_UPDATES=1

USER vscode
WORKDIR /workspace
