# Git 管理しない、コンテナ固有の環境変数を記載します。
# .devcontainer/.env にコピーすると、ビルド時とコンテナ実行時の両方で利用できます。

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# http_proxy=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080
# NO_PROXY=bedrock.ap-northeast-1.amazonaws.com
# no_proxy=bedrock.ap-northeast-1.amazonaws.com
