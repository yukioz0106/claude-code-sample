# Snowflake接続用のOAuth認証の環境変数（全項目必須）
# 値を実際の設定に置き換え、リポジトリ直下の .env に設定する。
# このファイル自体は処理から読み込まれない（python-dotenv等で.envを読み込んだ上で実行する）。
# ロール・ウェアハウス・データベース・スキーマ、認証方式、キャッシュは
# 同じディレクトリの snowflake_oauth.yml で設定する。

# Snowflakeアカウント識別子
SNOWFLAKE_ACCOUNT=your_account_identifier
# OAuth認証で接続する操作者本人のSnowflakeユーザー
SNOWFLAKE_OAUTH_USER=your_user@example.com

# Entra IDのテナントID（GUID）
MSAL_SF_TENANT_ID=00000000-0000-0000-0000-000000000000
# デバイスコード認証に使用するEntra IDアプリのクライアントID（GUID）
MSAL_SF_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Snowflake向けApplication ID URI（末尾の /.default は付けない）
MSAL_SF_APPLICATION_ID_URI=api://your_snowflake_application_id
